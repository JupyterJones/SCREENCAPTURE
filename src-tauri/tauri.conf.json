{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "esperanza-capture",
  "version": "2.0.0",
  "identifier": "com.esperanza.screencapture",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Esperanza Screen Capture",
        "label": "main",
        "width": 680,
        "height": 780,
        "minWidth": 580,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      },
      {
        "title": "Select Area",
        "label": "selector",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "ffmpeg",
          "zenity"
        ]
      }
    }
  }
}
